# Server Configuration
PORT=3000
# Set HOST to 127.0.0.1 for local security or 0.0.0.0 for LAN/Docker access
HOST=127.0.0.1

# Optional API Security (Protect /send-message with x-api-key header)
# API_KEY=your-secret-api-key-here

# Target phone number (e.g., 5217333432538)
TARGET_NUMBER=521XXXXXXXXXX

# API URL for send scripts
API_URL=http://localhost:3000/send-message
